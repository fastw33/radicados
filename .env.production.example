# Plantilla sin secretos. Archivo privado preparado: .env.production.
# API pública: https://radicados.appfastway.com
NODE_ENV=production
HOST=0.0.0.0
PORT=3010

# Dirección accesible desde el proceso o contenedor de Radicaciones.
MONGO_URI=
MONGO_DB_NAME=radicados

# Mismo valor que JWT_SECRET del WMS de producción. Solo backend.
JWT_SECRET=
# WMS actualmente no emite iss ni aud; mantener vacíos.
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ORIGINS=https://www.appfastway.com

# Mismo almacenamiento usado por Genika; prefijo exclusivo radicados/.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=radicados
# AWS S3: vacío. MinIO: URL del servicio S3, puerto 9000; no la consola 9001.
S3_ENDPOINT=
# MinIO: true. AWS S3: false.
S3_FORCE_PATH_STYLE=false
S3_PREFIX=radicados

# Conservar la clave actual y respaldarla. No sustituir al desplegar.
MARK_SECRET=

# Rutas Linux iguales a las del Dockerfile incluido.
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_PYTHON=/usr/bin/python3
CONVERSION_MODE=persistent
CONVERSION_TIMEOUT_MS=60000
MAX_FILE_MB=20
MAX_PAGES=100
PREVIEW_HOURS=24
RATE_LIMIT_PER_MINUTE=90
