{
  "name": "genika-radicados-api",
  "version": "1.0.0",
  "private": true,
  "description": "API independiente de correspondencia y radicados Genika",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:production": "node --env-file=.env.production src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "config:genika": "node scripts/configure-genika.js",
    "qa:pdf": "node scripts/pdf-qa.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4"
  }
}
