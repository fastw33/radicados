NODE_ENV=development
HOST=127.0.0.1
PORT=3010
MONGO_URI=mongodb://127.0.0.1:27017/radicados
MONGO_DB_NAME=radicados
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ORIGINS=http://localhost:5173
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=radicados
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=radicados
# Clave aleatoria hexadecimal de 32 bytes. Conservarla para verificar documentos.
MARK_SECRET=
# Ruta absoluta a soffice.com en Windows; soffice en Linux/Docker.
LIBREOFFICE_PATH=soffice
# Motor preparado entre documentos. process conserva el modo de arranque por archivo.
CONVERSION_MODE=persistent
# Opcional: python.exe de LibreOffice en Windows; /usr/bin/python3 con python3-uno en Linux.
LIBREOFFICE_PYTHON=
CONVERSION_TIMEOUT_MS=60000
MAX_FILE_MB=20
MAX_PAGES=100
PREVIEW_HOURS=24
RATE_LIMIT_PER_MINUTE=90
